# Copy to .env.local for Dev. Use a NEW Supabase, never the Preview project.
# Preview is preserved separately in .env.preview.local (also ignored by Git).
# These two values are public application configuration.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Local UI preview only; ignored in release builds. Do not enable for backend tests.
EXPO_PUBLIC_ENABLE_DEMO=false

# Optional error monitoring. DSN is public; never put SENTRY_AUTH_TOKEN here.
EXPO_PUBLIC_SENTRY_DSN=
# development locally; preview and production are selected in EAS.
EXPO_PUBLIC_APP_ENV=development
# Opt in to reports from Metro/development builds; false by default.
EXPO_PUBLIC_MONITORING_IN_DEV=false

# Optional native build configuration, NOT an EXPO_PUBLIC variable.
# Dev: pl.razemgo.app.development -> google-services.development.json
# Preview: pl.razemgo.app.dev -> google-services.json
# EAS has a separate GOOGLE_SERVICES_JSON file variable in each environment.
# GOOGLE_SERVICES_JSON=C:/path/to/google-services.development.json

# Maps SDK for Android: restrict to the Dev package + signing certificate SHA-1.
# Also configure this build-time variable in the EAS development environment.
GOOGLE_MAPS_ANDROID_API_KEY=
# Optional browser map only; Android does not use Maps JavaScript API.
EXPO_PUBLIC_GOOGLE_MAPS_WEB_KEY=
