# Copy to .env.local. These two values are public application configuration.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Local UI preview only; ignored in release builds. Do not enable for backend tests.
EXPO_PUBLIC_ENABLE_DEMO=false

# Optional native build configuration, NOT an EXPO_PUBLIC variable.
# Download from Firebase for pl.razemgo.app.dev, or use an EAS file variable.
# GOOGLE_SERVICES_JSON=C:/path/to/google-services.json
