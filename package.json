    "test:home": "node --test scripts/home.test.mjs",
    "test:notifications": "node --test scripts/notifications.test.mjs scripts/push.test.mjs scripts/push-backend.test.mjs scripts/notification-center-backend.test.mjs",
    "test:animals": "node --test scripts/animals.test.mjs",
    "start:dev": "expo start --dev-client --scheme razemgo-dev",
    "check:preview": "node scripts/check-preview.mjs",
    "check:dev": "node scripts/check-development.mjs",
    "build:dev": "npx eas-cli@latest build --platform android --profile development",
    "backend:dev": "node scripts/supabase-environment.mjs development",
    "backend:preview": "node scripts/supabase-environment.mjs preview",
