{
  "name": "razemgo",
  "main": "expo-router/entry",
  "version": "1.3.0",
  "dependencies": {
    "@expo/ui": "~58.0.25",
    "@sentry/react-native": "~8.28.0",
    "@supabase/supabase-js": "^2.118.0",
    "expo": "~58.0.21",
    "expo-application": "~58.1.2",
    "expo-auth-session": "~58.0.16",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.17",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.15",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.28",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@playwright/test": "^1.64.1",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "version": "node scripts/sync-app-version.mjs",
    "version:check": "node scripts/sync-app-version.mjs --check",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "prebuild:dev": "npm run version:check",
    "prebuild:performance": "npm run version:check",
    "prebuild:preview": "npm run version:check",
    "locations:import": "node scripts/import-localities.mjs",
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test:discovery": "node --test scripts/discovery.test.mjs",
    "test:profile": "node --test scripts/profile.test.mjs",
    "test:messaging": "node --test scripts/messaging.test.mjs scripts/messaging-data.test.mjs scripts/messaging-backend.test.mjs",
    "test:trips": "node --test scripts/trips.test.mjs",
    "test:trip-maps": "node --test scripts/trip-maps.test.mjs",
    "test:locations": "node --test scripts/locations.test.mjs",
    "test:home": "node --test scripts/home.test.mjs",
    "test:notifications": "node --test scripts/notifications.test.mjs scripts/push.test.mjs scripts/push-backend.test.mjs scripts/notification-center-backend.test.mjs",
    "test:animals": "node --test scripts/animals.test.mjs",
    "start:dev": "expo start --dev-client --scheme razemgo-dev",
    "start:demo": "node scripts/start-local-demo.mjs",
    "test:groups": "node --test scripts/groups.test.mjs scripts/groups-backend.test.mjs scripts/group-compatibility-backend.test.mjs scripts/group-profile-store.test.mjs scripts/group-trip-pagination-backend.test.mjs",
    "check:preview": "node scripts/check-preview.mjs",
    "check:dev": "node scripts/check-development.mjs",
    "build:dev": "npx eas-cli@latest build --platform android --profile development",
    "backend:dev": "node scripts/supabase-environment.mjs development",
    "backend:preview": "node scripts/supabase-environment.mjs preview",
    "build:preview": "npx eas-cli@latest build --platform android --profile preview",
    "test:auth": "node --test scripts/auth.test.mjs",
    "test:monitoring": "node --test scripts/monitoring.test.mjs",
    "test:push-health": "node --test scripts/push-health.test.mjs scripts/push-health-backend.test.mjs scripts/proposal-health-backend.test.mjs",
    "test:moderation": "node --test scripts/moderation-backend.test.mjs",
    "test:backend": "node --test scripts/backend.test.mjs",
    "test": "node --test scripts/*.test.mjs",
    "test:web": "playwright test",
    "types:database": "node scripts/generate-database-types.mjs",
    "check:source": "node scripts/check-source-safety.mjs",
    "test:local-backend": "node scripts/local-backend-check.mjs",
    "benchmark:sql": "node scripts/benchmark-sql.mjs",
    "benchmark:load": "node scripts/benchmark-load.mjs",
    "benchmark:sessions": "node scripts/benchmark-sessions.mjs",
    "test:edge": "npx --yes deno@2.9.6 test --config supabase/functions/deno.json --frozen --allow-env --allow-net --allow-sys --allow-read supabase/functions/_shared/monitoring.test.ts supabase/functions/_shared/monitoring-dev.test.ts supabase/functions/dispatch-push/handler.test.ts supabase/functions/monitor-push/handler.test.ts supabase/functions/delete-account/handler.test.ts",
    "build:performance": "npx eas-cli@latest build --platform android --profile performance"
  },
  "private": true
}
